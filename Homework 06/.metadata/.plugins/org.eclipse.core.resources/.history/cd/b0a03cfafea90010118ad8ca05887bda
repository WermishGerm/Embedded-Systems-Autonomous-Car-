#include "msp430.h"
#include "ports.h"
#include "macros.h"
#include "LCD.h"
#include <string.h>

extern volatile unsigned char display_changed;
extern char display_line[4][11];

volatile unsigned int sw1_debounce_count = 0;
volatile unsigned int sw2_debounce_count = 0;
volatile char sw1_blocked = 0;
volatile char sw2_blocked = 0;

#define DEBOUNCE_THRESHOLD  200   // adjust for ~800-1200ms

void Init_Switches(void){
    // SW1 - P4.1
    P4DIR &= ~SW1;     // Input
    P4REN |= SW1;      // Pull-up
    P4OUT |= SW1;
    P4IES |= SW1;      // High-to-low edge
    P4IFG &= ~SW1;
    P4IE  |= SW1;      // Enable interrupt

    // SW2 - P2.3
    P2DIR &= ~SW2;
    P2REN |= SW2;
    P2OUT |= SW2;
    P2IES |= SW2;      // High-to-low
    P2IFG &= ~SW2;
    P2IE  |= SW2;      // Enable interrupt
}

//-------------------- SW1 ISR --------------------
#pragma vector=PORT4_VECTOR
__interrupt void Port4_ISR(void){
    if(P4IFG & SW1){
        P4IFG &= ~SW1;
        P4IE  &= ~SW1;      // Disable further interrupts
        sw1_blocked = 1;
        sw1_debounce_count = 0;
        TB0CCTL1 |= CCIE;   // Enable SW1 debounce timer
        P6OUT &= ~LCD_BACKLITE; // Turn off backlight
        strcpy(display_line[3], "Switch 1");
        display_changed = TRUE;
    }
}

//-------------------- SW2 ISR --------------------
#pragma vector=PORT2_VECTOR
__interrupt void Port2_ISR(void){
    if(P2IFG & SW2){
        P2IFG &= ~SW2;
        P2IE  &= ~SW2;      // Disable further interrupts
        sw2_blocked = 1;
        sw2_debounce_count = 0;
        TB0CCTL2 |= CCIE;   // Enable SW2 debounce timer
        P6OUT &= ~LCD_BACKLITE; // Turn off backlight
        strcpy(display_line[3], "Switch 2");
        display_changed = TRUE;
    }
}


