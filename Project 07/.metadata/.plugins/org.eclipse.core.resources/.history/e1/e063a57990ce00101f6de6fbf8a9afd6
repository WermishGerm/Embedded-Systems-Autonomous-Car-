#include "msp430.h"
#include "functions.h"
#include "LCD.h"
#include "macros.h"

volatile unsigned int timer_counter = 0;
volatile unsigned int LCD_counter = 0;
unsigned int delay_start = 0;

// Project 7 global timers (owned here)
unsigned long p7_timer_200ms = 0;
unsigned char p7_timer_enabled = 0;

void Init_Timers(void){
    TB0CTL = TBSSEL__SMCLK | TBCLR | MC__CONTINOUS | ID__2;
    TB0EX0 = TBIDEX__8;

    TB0CCR0 = TB0CCR0_INTERVAL;
    TB0CCTL0 = CCIE;

    TB0CTL &= ~TBIE;
    TB0CTL &= ~TBIFG;
}

#pragma vector = TIMER0_B0_VECTOR
__interrupt void Timer0_B0_ISR(void){
    timer_counter++;
    LCD_counter++;

    if(p7_timer_enabled){
        if(LCD_counter >= 40){
            p7_timer_200ms++;
            LCD_counter = 0;
        }
    }

    if(delay_start) delay_start--;

    TB0CCR0 += TB0CCR0_INTERVAL;
}
