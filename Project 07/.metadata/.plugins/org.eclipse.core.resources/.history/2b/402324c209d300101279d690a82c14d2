#include "msp430.h"
#include <string.h>
#include "functions.h"
#include "LCD.h"
#include "macros.h"
#include "ports.h"
#include "switches.h"

// ===================== ADC Inputs =====================
extern unsigned int ADC_Left_Detect;
extern unsigned int ADC_Right_Detect;

// ===================== Display =========================
extern char display_line[4][11];
extern volatile unsigned char display_changed;
extern volatile unsigned char update_display;

// ===================== Switches ========================
extern volatile unsigned char sw1_pressed;

// ===================== Timer ===========================
extern volatile unsigned int timer_counter;

// ===================== Project 7 State =================
unsigned char p7_state = WAIT_START;

// ===================== Calibration ======================
unsigned int ambL=0, ambR=0;
unsigned int whiteL=0, whiteR=0;
unsigned int blackL=0, blackR=0;
unsigned int thrL=2000, thrR=2000;

// ===================== Laps ============================
unsigned char crossing = 0;
unsigned int lap_start_time = 0;

// ===================== Display Timer ===================
unsigned int last_tick = 0;
unsigned int t_count = 0;
unsigned char freeze_display = 0;

// ===================== State Label ======================
char state_label[11] = "          ";

void update_state_label(const char *txt) {
    memset(state_label, ' ', 10);
    memcpy(state_label, txt, strlen(txt));
}

// ===================== HEX Conversion ==================
char hexbuf[4];
void HEXtoBCD(unsigned int v){
  hexbuf[0] = '0' + v/1000; v%=1000;
  hexbuf[1] = '0' + v/100;  v%=100;
  hexbuf[2] = '0' + v/10;
  hexbuf[3] = '0' + v%10;
}

// ===================== ADC on LCD ======================
void showADC(void){
  HEXtoBCD(ADC_Left_Detect);
  memcpy(&display_line[2][2], hexbuf, 4);

  HEXtoBCD(ADC_Right_Detect);
  memcpy(&display_line[2][7], hexbuf, 4);
}

// ===================== Threshold Calculation ===========
void compute_thresholds(void){
  thrL = whiteL + ((blackL - whiteL) * 35) / 100;
  thrR = whiteR + ((blackR - whiteR) * 35) / 100;
}

// ===================== LCD Helpers =====================
void clear_display_lines(void){
  int i;
  for(i=0;i<4;i++) memset(display_line[i], ' ', ELEVENTH);
}

unsigned char detect_white(void){
  return (ADC_Left_Detect < thrL && ADC_Right_Detect < thrR);
}

unsigned char detect_black_both(void){
  return (ADC_Left_Detect > thrL && ADC_Right_Detect > thrR);
}

// ===================== PWM Line Follower ===============
void follow_line_pwm(void) {

    int base = 500;
    int minS = 350;
    int maxS = 900;

    int Lsig = ADC_Left_Detect  - thrL;
    int Rsig = ADC_Right_Detect - thrR;

    if(Lsig < 0) Lsig = 0;
    if(Rsig < 0) Rsig = 0;

    int diff = Lsig - Rsig;
    int adjust = diff;

    // Hard correction
    if (ADC_Left_Detect > thrL*1.2 && ADC_Right_Detect < thrR) {
        LEFT_FORWARD_SPEED  = 350;
        RIGHT_FORWARD_SPEED = 750;
        return;
    }
    if (ADC_Right_Detect > thrR*1.2 && ADC_Left_Detect < thrL) {
        LEFT_FORWARD_SPEED  = 750;
        RIGHT_FORWARD_SPEED = 350;
        return;
    }

    int L = base - adjust;
    int R = base + adjust;

    if(L < minS) L = minS;
    if(R < minS) R = minS;
    if(L > maxS) L = maxS;
    if(R > maxS) R = maxS;

    LEFT_FORWARD_SPEED = L;
    RIGHT_FORWARD_SPEED = R;
}

// ===================== ALIGN (fixed) ====================
void align_to_line(void){

    P2OUT |= IR_LED;

    unsigned char L_on = (ADC_Left_Detect  > thrL);
    unsigned char R_on = (ADC_Right_Detect > thrR);

    // Both black → aligned
    if(L_on && R_on){
        stopall();
        __delay_cycles(200000);
        p7_state = CIRCLE1;
        return;
    }

    // Left sees black → turn right
    if(L_on && !R_on){
        LEFT_FORWARD_SPEED  = 350;
        RIGHT_REVERSE_SPEED = 350;
        return;
    }

    // Right sees black → turn left
    if(R_on && !L_on){
        LEFT_REVERSE_SPEED  = 350;
        RIGHT_FORWARD_SPEED = 350;
        return;
    }

    // Neither sees black → sweep CCW
    LEFT_REVERSE_SPEED  = 350;
    RIGHT_FORWARD_SPEED = 350;
}

// ========================================================
//                 PROJECT 7 STATE MACHINE
// ========================================================
void project7_state_machine(void){

    // Show sensor ADCs always
    showADC();

    // Show state label every loop
    memcpy(display_line[1], state_label, 10);

    // LCD Timer Update (blocked during calibration)
    if (!freeze_display) {
        if ((timer_counter - last_tick) >= 20) {
            last_tick = timer_counter;
            t_count++;

            int sec = t_count / 5;
            int tenths = t_count % 5;

            HEXtoBCD(sec);
            memcpy(display_line[0], hexbuf, 4);

            display_line[0][4] = '.';
            display_line[0][5] = '0' + tenths*2;

            display_changed = TRUE;
            update_display  = TRUE;
        }
    }

    switch(p7_state){

// =======================================================
// WAIT_START
// =======================================================
case WAIT_START:
    update_state_label("WAIT");
    clear_display_lines();

    memcpy(display_line[1], state_label, 10);
    strcpy(display_line[3], "PRESS SW1");

    display_changed = TRUE;

    if(sw1_pressed){
        sw1_pressed = 0;
        __delay_cycles(200000);
        p7_state = CAL_AMBIENT;
    }
    break;

// =======================================================
// CAL_AMBIENT
// =======================================================
case CAL_AMBIENT:
    update_state_label("AMBIENT");
    freeze_display = 1;

    clear_display_lines();
    memcpy(display_line[1], state_label, 10);

    ambL = ADC_Left_Detect;
    ambR = ADC_Right_Detect;

    HEXtoBCD(ambL); memcpy(&display_line[2][2], hexbuf, 4);
    HEXtoBCD(ambR); memcpy(&display_line[3][2], hexbuf, 4);

    display_changed = TRUE;

    __delay_cycles(2000000);
    freeze_display = 0;

    p7_state = CAL_WHITE;
    break;

// =======================================================
// CAL_WHITE
// =======================================================
case CAL_WHITE:
    update_state_label("WHITE");
    freeze_display = 1;

    clear_display_lines();
    memcpy(display_line[1], state_label, 10);

    whiteL = ADC_Left_Detect;
    whiteR = ADC_Right_Detect;

    HEXtoBCD(whiteL); memcpy(&display_line[2][2], hexbuf, 4);
    HEXtoBCD(whiteR); memcpy(&display_line[3][2], hexbuf, 4);

    display_changed = TRUE;
    __delay_cycles(2000000);

    freeze_display = 0;
    p7_state = CAL_WAIT_BLACK;
    break;

// =======================================================
// CAL_WAIT_BLACK
// =======================================================
case CAL_WAIT_BLACK:
    update_state_label("TO BLACK");

    clear_display_lines();
    memcpy(display_line[1], state_label, 10);
    strcpy(display_line[3], "PRESS SW1");

    display_changed = TRUE;

    if(sw1_pressed){
        sw1_pressed = 0;
        __delay_cycles(200000);
        p7_state = CAL_BLACK;
    }
    break;

// =======================================================
// CAL_BLACK
// =======================================================
case CAL_BLACK:
    update_state_label("BLACK");
    freeze_display = 1;

    clear_display_lines();
    memcpy(display_line[1], state_label, 10);

    blackL = ADC_Left_Detect;
    blackR = ADC_Right_Detect;

    compute_thresholds();

    HEXtoBCD(blackL); memcpy(&display_line[2][2], hexbuf, 4);
    HEXtoBCD(blackR); memcpy(&display_line[3][2], hexbuf, 4);

    display_changed = TRUE;

    __delay_cycles(2500000);
    freeze_display = 0;

    p7_state = WAIT_IN_CENTER;
    break;

// =======================================================
// WAIT_IN_CENTER
// =======================================================
case WAIT_IN_CENTER:
    update_state_label("CENTER");

    clear_display_lines();
    memcpy(display_line[1], state_label, 10);
    strcpy(display_line[3], "PRESS SW1");

    display_changed = TRUE;

    if(sw1_pressed){
        sw1_pressed = 0;
        P2OUT |= IR_LED;
        p7_state = INTERCEPT;
    }
    break;

// =======================================================
// INTERCEPT
// =======================================================
case INTERCEPT:
    update_state_label("INTERCEPT");

    moveforward();

    if(detect_black_both()){
        stopall();
        __delay_cycles(250000);
        p7_state = TURN_ALIGN;
    }
    break;

// =======================================================
// TURN_ALIGN
// =======================================================
case TURN_ALIGN:
    update_state_label("ALIGN");

    align_to_line();
    break;

// =======================================================
// CIRCLE1
// =======================================================
case CIRCLE1:
    update_state_label("LAP 1");

    follow_line_pwm();

    if(detect_white() && !crossing){
        crossing = 1;
        lap_start_time = timer_counter;
    }

    if(crossing && detect_black_both() &&
       (timer_counter - lap_start_time) > 50){
        crossing = 0;
        stopall();
        __delay_cycles(300000);
        p7_state = CIRCLE2;
    }
    break;

// =======================================================
// CIRCLE2
// =======================================================
case CIRCLE2:
    update_state_label("LAP 2");

    follow_line_pwm();

    if(detect_white() && !crossing){
        crossing = 1;
        lap_start_time = timer_counter;
    }

    if(crossing && detect_black_both() &&
       (timer_counter - lap_start_time) > 50){
        crossing = 0;
        stopall();
        __delay_cycles(300000);
        p7_state = ENTER_CENTER;
    }
    break;

// =======================================================
// ENTER_CENTER
// =======================================================
case ENTER_CENTER:
    update_state_label("CENTERING");

    LEFT_REVERSE_SPEED  = 400;
    RIGHT_FORWARD_SPEED = 400;

    if(detect_white()){
        stopall();
        __delay_cycles(250000);
        moveforward();
    }

    if(detect_white()){
        stopall();
        P2OUT &= ~IR_LED;
        p7_state = STOPPED;
    }
    break;

// =======================================================
// STOPPED
// =======================================================
case STOPPED:
    update_state_label("STOPPED");
    stopall();
    break;

} // end switch
}
