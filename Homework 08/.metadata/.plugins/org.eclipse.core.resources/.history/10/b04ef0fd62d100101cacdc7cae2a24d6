// ---------------------------
//   MAIN PROGRAM
// ---------------------------
void main(void){
  WDTCTL = WDTPW | WDTHOLD;
  PM5CTL0 &= ~LOCKLPM5;

  Init_Ports();
  Init_Clocks();
  Init_Conditions();
  five_msec_sleep(10);   // Wait ~50ms for LCD power stabilization

  Init_LCD();
  Init_Timers();
  Init_ADC();

  Init_Serial_UCA1();   // <<< HW08: Enable PC UART
  Init_Serial_UCA0();   // <<< HW08: Enable IOT/Loopback UART

  enable_interrupts();

  // -------------------------------------------------------
  // HW08  SPLASH SCREEN (5 seconds)
  // -------------------------------------------------------
  strcpy(display_line[0], "           ");
  strcpy(display_line[1], " NCSU  #1  ");
  strcpy(display_line[2], "    Baud   ");
  strcpy(display_line[3], " 115,200   ");

  display_changed = TRUE;
  lcd_4line();
  five_msec_sleep(1000);   // 1000 × 5ms = 5 seconds

  //----------------------------------
  // Your existing project variables
  //----------------------------------
  wheel_move = 0;
  forward = TRUE;
  event = STRAIGHT;

  // -------------------------------------------------------
  // MAIN LOOP  (While OS)
  // -------------------------------------------------------
  while(ALWAYS) {

    Carlson_StateMachine();
    Switches_Process();          // <<< HW08: SW1 & SW2 control baud now
    Display_Process();

    // ------------------------------------------
    // HW08: Display characters received from UCA1
    // ------------------------------------------
    if (serial_rx_flag) {
        serial_rx_flag = 0;

        display_line[0][0] = usb_rx;  // Show received character
        display_line[0][1] = '\0';

        display_changed = TRUE;
    }

    P3OUT ^= TEST_PROBE;

    // Your existing Project 06 logic (unchanged)
    if(event == BLACK_LINE_FOLLOW){
        blackline_state();
        Update_Blackline_Display();
    }

    LCD_update();
  }
}
