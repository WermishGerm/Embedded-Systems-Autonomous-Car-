#include  "msp430.h"
#include  <string.h>
#include  "functions.h"
#include  "LCD.h"
#include "macros.h"
#include  "ports.h"
#include "serial.h"

volatile char usb_rx = 0;    // Last received character on UCA1

void Init_Serial_UCA1(void) {
    UCA1CTLW0 = 0;
    UCA1CTLW0 |= UCSWRST;        // Put eUSCI in reset
    UCA1CTLW0 |= UCSSEL__SMCLK;  // SMCLK = 8 MHz

    // UART settings: 8N1
    UCA1CTLW0 &= ~UCMSB;         // LSB first
    UCA1CTLW0 &= ~UCSPB;         // 1 stop bit
    UCA1CTLW0 &= ~UCPEN;         // No parity
    UCA1CTLW0 &= ~UCSYNC;        // UART mode

    // 115200 baud settings from lecture table:
    // BRW = 4, MCTLW = 0x5551
    UCA1BRW = 4;
    UCA1MCTLW = 0x5551;

    UCA1CTLW0 &= ~UCSWRST;       // Release reset

    UCA1IE |= UCRXIE;            // Enable RX interrupt

    UCA1TXBUF = 0x00;            // "Prime the pump"
}


#pragma vector = EUSCI_A1_VECTOR
__interrupt void eUSCI_A1_ISR(void) {

    switch(__even_in_range(UCA1IV, 0x08)) {

    case 0:
        break;

    case 2:  // RXIFG
        usb_rx = UCA1RXBUF;  // Read received character
        UCA0TXBUF = usb_rx;   // <-- forward to IOT

        break;

    case 4:  // TXIFG (not used here)
        break;
    }
}


void Init_Serial_UCA0(void) {

    UCA0CTLW0 = 0;
    UCA0CTLW0 |= UCSWRST;            // Hold in reset
    UCA0CTLW0 |= UCSSEL__SMCLK;      // SMCLK source

    UCA0CTLW0 &= ~UCMSB;
    UCA0CTLW0 &= ~UCSPB;
    UCA0CTLW0 &= ~UCPEN;
    UCA0CTLW0 &= ~UCSYNC;
    UCA0CTLW0 &= ~UC7BIT;

    // 115200 baud (same as UCA1)
    UCA0BRW   = 4;
    UCA0MCTLW = 0x5551;

    UCA0CTLW0 &= ~UCSWRST;           // Release reset

    UCA0IE |= UCRXIE;                // Enable RX interrupt

    UCA0TXBUF = 0x00;                // Prime pump
}


#pragma vector = EUSCI_A0_VECTOR
__interrupt void eUSCI_A0_ISR(void) {

    switch(__even_in_range(UCA0IV, 0x08)) {

    case 0:
        break;

    case 2:   // RXIFG – received from IOT (UCA0)
    {
        char value = UCA0RXBUF;
        UCA1TXBUF = value;   // Forward to PC
    }
        break;

    case 4:   // TXIFG – not used
        break;
    }
}
