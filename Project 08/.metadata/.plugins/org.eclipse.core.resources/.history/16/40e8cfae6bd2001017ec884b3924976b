void main(void){
  WDTCTL = WDTPW | WDTHOLD;
  PM5CTL0 &= ~LOCKLPM5;
  Init_Ports();
  Init_Clocks();
  Init_Conditions();
  Init_LCD();
  Init_Timers();
  Init_ADC();
  enable_interrupts();

  // --- Add this short delay to ensure DCO/FLL is stable:
  __delay_cycles(8000000);   // 1 ms @ 8 MHz
  Init_Serial();              // >>> PROJECT 8 ADD

  while (1) {
      while (!(UCA0IFG & UCTXIFG));  // wait until TX buffer is ready
      UCA0TXBUF = 'A';               // send ASCII 'A' repeatedly
  }
}
