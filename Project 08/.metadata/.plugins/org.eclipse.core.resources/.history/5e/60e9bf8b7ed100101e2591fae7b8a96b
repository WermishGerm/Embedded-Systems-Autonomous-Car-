#include "msp430.h"
#include "ports.h"

void Init_Ports(void){

  // ========================
  // UART UCA1 Pins P4.2 RX, P4.3 TX
  // ========================
  P4SEL0 |= BIT2 | BIT3;
  P4SEL1 &= ~(BIT2 | BIT3);

  P4DIR |= BIT3;   // TX
  P4DIR &= ~BIT2;  // RX

  // Keep all your other project port setups untouched!
}
