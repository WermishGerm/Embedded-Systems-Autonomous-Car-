#include "msp430.h"
#include "functions.h"
#include "macros.h"
#include "serial.h"
#include "ports.h"
#include "LCD.h"

void main(void) {

  WDTCTL = WDTPW | WDTHOLD;     // Stop watchdog timer
  PM5CTL0 &= ~LOCKLPM5;         // Unlock GPIO

  Init_Ports();                 
  Init_Clocks();
  Init_Timers();
  Init_LCD();
  Init_ADC();

  Init_Serial_UCA1();           // AD2 UART only

  __enable_interrupt();         // Enable interrupts

  // Splash Screen
  clear_display();
  Display_Line(0, " PROJECT 8 ");
  Display_Line(1, " SerialMode ");
  Display_Line(2, "    UCA1    ");
  Display_Line(3, "   Ready!   ");
  update_display();

  five_msec_sleep(200);         // Hold splash

  clear_display();
  Display_Line(0, "Awaiting");
  Display_Line(1, "Serial...");
  Display_Line(2, "115200");
  Display_Line(3, "");
  update_display();

  // ============================
  //       MAIN LOOP
  // ============================
  while(1) {

    Serial_Process_PC();        // Handle AD2/PC commands (^H, ^^, echo)

    Switches_Process();         // Still allows SW1/SW2 use

    // No movement, no state machine here. Safe Mode.
  }
}
