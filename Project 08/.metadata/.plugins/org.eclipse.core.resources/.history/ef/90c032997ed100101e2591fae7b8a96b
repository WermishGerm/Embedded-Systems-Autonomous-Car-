#include "msp430.h"
#include "functions.h"
#include "macros.h"
#include "serial.h"
#include "ports.h"
#include "LCD.h"

volatile char slow_input_down;
extern char display_line[FOURTH][ELEVENTH];
extern char *display[FOURTH];
unsigned char display_mode;
extern volatile unsigned char display_changed;
extern volatile unsigned char update_display;
extern volatile unsigned int update_display_count;
extern volatile unsigned int Time_Sequence;
extern volatile char one_time;
unsigned int test_value;
volatile char control_state[7];
unsigned int Last_Time_Sequence;
unsigned int wheel_move;
unsigned char forward;
unsigned char event;
unsigned int event_count;

extern unsigned int cycle_time;    // Defined in states.c
extern unsigned int time_change;   // Defined in states.c

void main(void) {

  WDTCTL = WDTPW | WDTHOLD;     // Stop watchdog timer
  PM5CTL0 &= ~LOCKLPM5;         // Unlock GPIO

  Init_Ports();                 
  Init_Clocks();
  Init_Timers();
  Init_LCD();
  Init_ADC();

  Init_Serial_UCA1();           // AD2 UART only

  __enable_interrupt();         // Enable interrupts

  // Splash Screen
  clear_display();
  strcpy(display_line[0], " PROJECT 8 ");
  strcpy(display_line[1], " SerialMode ");
  strcpy(display_line[2], "    UCA1    ");
  strcpy(display_line[3], "   Ready!   ");
  LCD_Update();
  five_msec_sleep(200);         // Hold splash

  clear_display();
  strcpy(display_line[0], "Awaiting");
  strcpy(display_line[1], "Serial...");
  strcpy(display_line[2], "115200");
  strcpy(display_line[3], "");
  LCD_Update();

  // ============================
  //       MAIN LOOP
  // ============================
  while(1) {

    Serial_Process_PC();        // Handle AD2/PC commands (^H, ^^, echo)

    Switches_Process();         // Still allows SW1/SW2 use

    // No movement, no state machine here. Safe Mode.
  }
}
