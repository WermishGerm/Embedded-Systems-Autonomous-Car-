
#include "msp430.h"
#include "functions.h"
#include "macros.h"
#include "serial.h"
#include "ports.h"
#include "LCD.h"

// Integrated main: Serial, movement, ADC, states

void main(void) {

  WDTCTL = WDTPW | WDTHOLD;
  PM5CTL0 &= ~LOCKLPM5;

  Init_Ports();
  Init_Clocks();
  Init_Timers();
  Init_LCD();
  Init_ADC();

  Init_Serial_UCA1();

  __enable_interrupt();

  clear_display();
  Display_Line(0, "   Project 8  ");
  Display_Line(1, " Full System  ");
  Display_Line(2, "  Integrated  ");
  Display_Line(3, "    Ready     ");
  update_display();

  five_msec_sleep(200);

  clear_display();
  Display_Line(0, "ADC Ready");
  Display_Line(1, "Motors Ready");
  Display_Line(2, "Serial Ready");
  Display_Line(3, "");
  update_display();

  while(1) {

    Serial_Process_PC();      // AD2/PC serial commands (^H, ^^, movement commands)
    Switches_Process();       // Debounced switch logic
    Carlson_StateMachine();   // Full motion/shape controller
    ADC_Process();            // Your ADC loop (if implemented)
  }
}
