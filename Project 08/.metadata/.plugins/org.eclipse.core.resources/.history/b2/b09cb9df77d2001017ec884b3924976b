#include "msp430.h"
#include <string.h>
#include "serial.h"
#include "LCD.h"
#include "functions.h"
#include "macros.h"

extern char display_line[4][11];
extern volatile unsigned char display_changed;

// RX globals
volatile char rx_buffer[11] = {0};
volatile unsigned int rx_index = 0;
volatile unsigned char message_ready = 0;

volatile unsigned char baud_mode = BAUD_9600;

// ------------------------------------------------------------
// UART Setup on UCA0 (P1.6 TX, P1.7 RX)
// ------------------------------------------------------------
void Init_Serial(void) {

    UCA0CTLW0 = UCSWRST;
    UCA0CTLW0 |= UCSSEL__SMCLK;

    Set_Baud(BAUD_9600);

    UCA0CTLW0 &= ~UCSWRST;
    UCA0IE |= UCRXIE;
}

void Set_Baud(unsigned char rate) {

    baud_mode = rate;
    UCA0CTLW0 |= UCSWRST;

    if(rate == BAUD_9600) {
        UCA0BRW   = 52;
        UCA0MCTLW = 0x4911;
        strcpy(display_line[2], "BR:9600    ");
    }
    else {
        UCA0BRW   = 4;
        UCA0MCTLW = 0x5551;
        strcpy(display_line[2], "BR:115200  ");
    }

    display_changed = TRUE;

    UCA0CTLW0 &= ~UCSWRST;
    UCA0IE |= UCRXIE;
}

void Serial_Process_RX(void) {

    if(!message_ready) return;

    strcpy(display_line[0], "Received   ");
    strcpy(display_line[1], "@          ")
    strcpy(display_line[3], rx_buffer);

    display_changed = TRUE;
    message_ready = 0;
}

void Transmit_Command(void) {

    if(strlen(rx_buffer) != 10) return;

    strcpy(display_line[0], "Transmit   ");
    strcpy(display_line[1], "Sent       ");
    display_changed = TRUE;
    unsigned int i;
    for(i = 0; i < 10; i++) {
        while(!(UCA0IFG & UCTXIFG));
        UCA0TXBUF = rx_buffer[i];
    }
}

#pragma vector = EUSCI_A0_VECTOR
__interrupt void EUSCI_A0_ISR(void) {

    if (UCA0IFG & UCRXIFG) {

        char c = UCA0RXBUF;

        // Ignore ALL non-printable ASCII characters
        if (c < ' ' || c > '~') {   // ' ' = 32, '~' = 126
            return;
        }

        // Start fresh if beginning of message
        if (rx_index == 0) {
            memset((char*)rx_buffer, 0, 11);
        }

        rx_buffer[rx_index++] = c;

        if (rx_index >= 10) {
            rx_buffer[10] = '\0';
            message_ready = 1;
            rx_index = 0;
        }
    }
}
