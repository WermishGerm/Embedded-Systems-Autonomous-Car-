#include "functions.h"
#include "LCD.h"
#include "macros.h"
#include "ports.h"
#include "serial.h"

#include "msp430.h"
#include <string.h>
#include "IOTtrans.h"

// ================= RING BUFFERS =================

volatile char pc_to_iot[RING_SIZE];
volatile char iot_to_pc[RING_SIZE];

volatile uint16_t pc_iot_head = 0;
volatile uint16_t pc_iot_tail = 0;

volatile uint16_t iot_pc_head = 0;
volatile uint16_t iot_pc_tail = 0;

// ================= FRAM COMMAND HANDLING =================

volatile uint8_t fram_mode = 0;
volatile uint8_t fram_index = 0;

char fram_cmd[20];

// ==========================================================
//  UART INITIALIZATION
// ==========================================================

// -------- PC UART (UCA1) @ 115200 --------
void Init_UART_PC(void) {
    UCA1CTLW0 = UCSWRST;
    UCA1CTLW0 |= UCSSEL__SMCLK;

    UCA1BRW = 4;
    UCA1MCTLW = 0x5551;

    UCA1CTLW0 &= ~UCSWRST;
    UCA1IE |= UCRXIE;
}

// -------- IOT UART (UCA0) @ selectable speed --------
void Init_UART_IOT(uint8_t baud_mode) {
    UCA0CTLW0 = UCSWRST;
    UCA0CTLW0 |= UCSSEL__SMCLK;

    if(baud_mode == BAUD_115200) {
        UCA0BRW = 4;
        UCA0MCTLW = 0x5551;
    } else {
        UCA0BRW = 52;
        UCA0MCTLW = 0x4911;
    }

    UCA0CTLW0 &= ~UCSWRST;
    UCA0IE |= UCRXIE;
}

// ==========================================================
//  UART CHARACTER SEND UTILITIES
// ==========================================================

void UART_PC_TX(char c) {
    while (!(UCA1IFG & UCTXIFG));
    UCA1TXBUF = c;
}

void UART_IOT_TX(char c) {
    while (!(UCA0IFG & UCTXIFG));
    UCA0TXBUF = c;
}

// ==========================================================
//  UCA1 ISR (PC TERMINAL)
// ==========================================================
#pragma vector = EUSCI_A1_VECTOR
__interrupt void EUSCI_A1_ISR(void) {

    if (UCA1IFG & UCRXIFG) {
        char c = UCA1RXBUF;

        if (c == '^' && fram_mode == 0) {
            fram_mode = 1;
            fram_index = 0;
            memset(fram_cmd, 0, sizeof(fram_cmd));
            fram_cmd[fram_index++] = '^';
            return;
        }

        if (fram_mode) {
            fram_cmd[fram_index++] = c;

            if (c == '\r' || fram_index >= 18) {
                fram_mode = 0;
                fram_cmd[fram_index] = '\0';
                Process_FRAM_Command();
            }
            return;
        }

        pc_to_iot[pc_iot_head++] = c;
        pc_iot_head &= (RING_SIZE - 1);
    }
}

// ==========================================================
//  UCA0 ISR (IOT MODULE)
// ==========================================================
#pragma vector = EUSCI_A0_VECTOR
__interrupt void EUSCI_A0_ISR(void) {

    if (UCA0IFG & UCRXIFG) {
        char c = UCA0RXBUF;

        iot_to_pc[iot_pc_head++] = c;
        iot_pc_head &= (RING_SIZE - 1);
    }
}

// ==========================================================
//  BRIDGE LOGIC (called in main loop)
// ==========================================================
void UART_Bridge_Process(void) {

    while (pc_iot_tail != pc_iot_head) {
        UART_IOT_TX(pc_to_iot[pc_iot_tail]);
        pc_iot_tail = (pc_iot_tail + 1) & (RING_SIZE - 1);
    }

    while (iot_pc_tail != iot_pc_head) {
        UART_PC_TX(iot_to_pc[iot_pc_tail]);
        iot_pc_tail = (iot_pc_tail + 1) & (RING_SIZE - 1);
    }
}

// ==========================================================
//  FRAM-ONLY COMMAND HANDLING
// ==========================================================
void Process_FRAM_Command(void) {

    if (strcmp(fram_cmd, "^^") == 0) {
        char *msg = "I'm here\r\n";
        for (int i = 0; msg[i] != 0; i++)
            UART_PC_TX(msg[i]);
        return;
    }

    if (strcmp(fram_cmd, "^F") == 0) {
        Init_UART_IOT(BAUD_115200);
        return;
    }

    if (strcmp(fram_cmd, "^S") == 0) {
        Init_UART_IOT(BAUD_9600);
        return;
    }
}
