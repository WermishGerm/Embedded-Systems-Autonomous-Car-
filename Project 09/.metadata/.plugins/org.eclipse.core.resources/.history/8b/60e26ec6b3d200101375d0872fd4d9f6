#include <string.h>
#include <stdlib.h>
#include "ports.h"

// ============================================================================
// PWM CONSTANTS
// 800 Hz PWM on Timer A1
// ============================================================================
#define PWM_PERIOD      10000
#define PWM_SPEED       5500     // 55% duty — stable and smooth

// Movement timing (ms)
#define TURN_90_MS      900
#define TURN_45_MS      450
#define FORWARD_MS(v)   ((v) * 1000)
#define BACKWARD_MS(v)  ((v) * 1000)

// ============================================================================
// MOVEMENT STATE MACHINE
// ============================================================================
typedef enum {
    MOVE_IDLE = 0,
    MOVE_RUNNING,
} MoveState;

volatile MoveState move_state = MOVE_IDLE;
volatile uint16_t move_timer_ms = 0;

// ============================================================================
// QUEUE IMPLEMENTATION
// ============================================================================
MoveCmd move_queue[MOVE_QUEUE_SIZE];
uint8_t move_q_head = 0;
uint8_t move_q_tail = 0;

void movement_queue_push(char direction, uint16_t value) {
    uint8_t next = (move_q_head + 1) % MOVE_QUEUE_SIZE;
    if (next == move_q_tail) return; // queue full — ignore
    move_queue[move_q_head].direction = direction;
    move_queue[move_q_head].value = value;
    move_q_head = next;
}

uint8_t movement_queue_pop(MoveCmd *out) {
    if (move_q_tail == move_q_head) return 0; // empty
    *out = move_queue[move_q_tail];
    move_q_tail = (move_q_tail + 1) % MOVE_QUEUE_SIZE;
    return 1;
}

// ============================================================================
// PWM INITIALIZATION (Timer A1)
// ============================================================================
static void Init_PWM(void) {
    TA1CCR0 = PWM_PERIOD;     // PWM period

    // LEFT WHEEL PWM — TA1.1
    TA1CCTL1 = OUTMOD_7;
    TA1CCR1 = 0;

    // RIGHT WHEEL PWM — TA1.2
    TA1CCTL2 = OUTMOD_7;
    TA1CCR2 = 0;

    TA1CTL = TASSEL__SMCLK | MC__UP | TACLR;
}

// ============================================================================
// WHEEL CONTROL HELPERS
// ============================================================================
static void wheels_forward(void) {
    TA1CCR1 = PWM_SPEED;
    TA1CCR2 = PWM_SPEED;
}

static void wheels_backward(void) {
    TA1CCR1 = PWM_SPEED;
    TA1CCR2 = PWM_SPEED;
    // Your hardware uses REVERSE pins; if needed add P6 manipulation here.
}

static void wheels_left(void) {
    TA1CCR1 = 0;
    TA1CCR2 = PWM_SPEED;
}

static void wheels_right(void) {
    TA1CCR1 = PWM_SPEED;
    TA1CCR2 = 0;
}

void movement_stop(void) {
    TA1CCR1 = 0;
    TA1CCR2 = 0;
}

// ============================================================================
// INIT
// ============================================================================
void movement_init(void) {
    Init_PWM();
    move_state = MOVE_IDLE;
    move_timer_ms = 0;
}

// ============================================================================
// BIG FONT DISPLAY
// ============================================================================
void movement_display_big(char direction, uint16_t value) {
    char buff[12];
    sprintf(buff, "%c%u", direction, value);
    lcd_BIG_mid(buff);
}

// ============================================================================
// EXECUTE ONE NEW COMMAND
// ============================================================================
void movement_execute_command(char direction, uint16_t value) {

    // Display big font
    movement_display_big(direction, value);

    // Determine movement duration
    switch(direction) {
    case 'F':
        wheels_forward();
        move_timer_ms = FORWARD_MS(value);
        break;

    case 'B':
        wheels_backward();
        move_timer_ms = BACKWARD_MS(value);
        break;

    case 'L':
        wheels_left();
        move_timer_ms = (value == 45 ? TURN_45_MS : TURN_90_MS);
        break;

    case 'R':
        wheels_right();
        move_timer_ms = (value == 45 ? TURN_45_MS : TURN_90_MS);
        break;

    default:
        return; // invalid
    }

    move_state = MOVE_RUNNING;
}

// ============================================================================
// EXECUTE STRING COMMAND (like "F2" or "R90")
// ============================================================================
void movement_execute_string(char *cmd) {
    if (!cmd || strlen(cmd) < 2) return;

    char direction = cmd[0];
    uint16_t value = atoi(&cmd[1]);
    if (value == 0) return;

    movement_queue_push(direction, value);
}

// ============================================================================
// UPDATE — called each main loop
// ============================================================================
void movement_update(void) {

    if (move_state == MOVE_RUNNING) {

        if (move_timer_ms > 0) {
            move_timer_ms--;
            return;
        }

        // Movement finished
        movement_stop();
        lcd_4line();

        MoveCmd next;
        if (movement_queue_pop(&next)) {
            movement_execute_command(next.direction, next.value);
        } else {
            move_state = MOVE_IDLE;
        }
    }

    // If idle, start next queued command
    if (move_state == MOVE_IDLE) {
        MoveCmd next;
        if (movement_queue_pop(&next)) {
            movement_execute_command(next.direction, next.value);
        }
    }
}
